  # Auth — Login com Google
  # Único e-mail considerado admin do sistema. Comparação por igualdade. Deixe
  # vazio se este ambiente não tem admin. Singular (não é lista — Player/GM é
  # capability de mesa, não permissão de conta).
  ADMIN_EMAIL=""
  # CSV de e-mails permitidos. Vazio = login aberto (qualquer Google account
  # pode entrar). Preencha para restringir (ex.: "a@x.com,b@y.com").
  ALLOWED_EMAILS=""
  # Cookie httpOnly de sessão (criado via Firebase createSessionCookie).
  SESSION_COOKIE_NAME="arcana_session"
  SESSION_MAX_AGE_DAYS="7"