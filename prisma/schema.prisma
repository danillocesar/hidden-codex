// Arcana Forge — Prisma schema
// Documentação detalhada: arcana-forge-spec/03-DATA-MODEL.md
// Convenções: tabelas em snake_case, modelos em PascalCase, FKs com @map.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ══════════════════════════════════════════════════════════════════════
// USUÁRIOS E AUTENTICAÇÃO
// ══════════════════════════════════════════════════════════════════════

model User {
  id          String   @id @default(uuid()) @db.Uuid
  firebaseUid String   @unique @map("firebase_uid")
  email       String   @unique
  displayName String?  @map("display_name")
  avatarUrl   String?  @map("avatar_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  characters Character[]
  shareLinks ShareLink[]

  @@map("users")
}

// ══════════════════════════════════════════════════════════════════════
// PERSONAGENS
// ══════════════════════════════════════════════════════════════════════

model Character {
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Identidade
  name          String
  age           Int?
  gender        String?
  campaignLevel Int           @map("campaign_level")
  rank          CharacterRank @default(GENIN)
  tendency      String?
  size          CharacterSize @default(MEDIUM)

  // Referencial (FK opcionais para catálogos)
  clanId            String?       @map("clan_id") @db.Uuid
  clan              Clan?         @relation(fields: [clanId], references: [id])
  villageId         String?       @map("village_id") @db.Uuid
  village           Village?      @relation(fields: [villageId], references: [id])
  // Vila customizada (texto livre) — usada quando o personagem é de uma vila
  // não-canônica. Excludente com `villageId` na UI, mas o banco permite ambos
  // para flexibilidade (validação fica no domínio).
  customVillageName String?       @map("custom_village_name")
  // Clã customizado: mesma lógica de `customVillageName`. Usado quando o
  // personagem é de um clã não-catalogado (homebrew ou clã que ainda não foi
  // seedado). Excludente com `clanId` na UI.
  customClanName    String?       @map("custom_clan_name")
  kekkeiGenkaiId    String?       @map("kekkei_genkai_id") @db.Uuid
  kekkeiGenkai      KekkeiGenkai? @relation(fields: [kekkeiGenkaiId], references: [id])

  // Atributos primários (7)
  attrFor Int @default(1) @map("attr_for")
  attrDes Int @default(1) @map("attr_des")
  attrAgi Int @default(1) @map("attr_agi")
  attrPer Int @default(1) @map("attr_per")
  attrInt Int @default(1) @map("attr_int")
  attrVig Int @default(1) @map("attr_vig")
  attrEsp Int @default(1) @map("attr_esp")

  // Habilidades de combate (bases — remanejamento permitido)
  baseCc  Int @default(5) @map("base_cc")
  baseCd  Int @default(3) @map("base_cd")
  baseEsq Int @default(3) @map("base_esq")
  baseLm  Int @default(1) @map("base_lm")

  // Sociais
  socialCarisma     Int @default(0) @map("social_carisma")
  socialManipulacao Int @default(0) @map("social_manipulacao")

  // Energias correntes
  currentVitality Int @map("current_vitality")
  currentChakra   Int @map("current_chakra")

  // Bio/lore livre
  biography String? @db.Text

  // Estado de UI (Json estruturado — ver 03-DATA-MODEL.md §"UIState")
  uiState Json @default("{}") @map("ui_state")

  // Recursos
  ryos Int @default(0)

  // Visibilidade pública (perfil público)
  isPublicOnProfile Boolean @default(false) @map("is_public_on_profile")

  // Metadados
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  pericias     CharacterPericia[]
  aptitudes    CharacterAptitude[]
  powers       CharacterPower[]
  jutsus       CharacterJutsu[]
  inventory    CharacterInventoryItem[]
  diaryEntries DiaryEntry[]
  shareLinks   ShareLink[]
  images       CharacterImage[]

  @@index([userId])
  @@index([deletedAt])
  @@map("characters")
}

enum CharacterRank {
  ACADEMICO
  GENIN
  CHUUNIN
  JOUNIN
  ANBU
  KAGE
}

enum CharacterSize {
  MINUSCULO
  MIUDO
  PEQUENO
  MEDIUM
  GRANDE
  ENORME
  COLOSSAL
}

// ══════════════════════════════════════════════════════════════════════
// PERÍCIAS
// ──────────────────────────────────────────────────────────────────────
// Catálogo seedado a partir de `prisma/seed-data/pericias.json` (20 entradas
// do Livro Básico 4.1b). Não há FK Prisma entre `CharacterPericia.periciaCode`
// e `Pericia.code` por decisão da spec (03-DATA-MODEL.md §"Por que perícias têm
// periciaCode string em vez de FK?"): a lista é fechada e o domínio garante
// consistência. A tabela serve para UI/admin lookups e source-of-truth do seed.
// ══════════════════════════════════════════════════════════════════════

model Pericia {
  id               String  @id @default(uuid()) @db.Uuid
  code             String  @unique
  name             String
  /// Atributo ligado. Aceita os 7 primários (`for`, `des`, `agi`, `per`, `int`,
  /// `vig`, `esp`) e também atributos sociais (`car` — Obter Informação).
  /// Não é enum porque a regra do livro permite extensão futura.
  attribute        String
  /// `true` quando a perícia é marcada com [x] no livro — não pode ser usada
  /// sem ao menos 1 ponto investido.
  trained          Boolean @default(false)
  /// `true` quando marcada com [x][x] — requer aptidão especial para comprar
  /// (ex.: Venefício requer Químico).
  doubleTrained    Boolean @default(false) @map("double_trained")
  /// Acrobacia, Atletismo e Furtividade sofrem penalidade quando o
  /// personagem usa armadura.
  armorPenalty     Boolean @default(false) @map("armor_penalty")
  /// Ordem de exibição na ficha (1..20).
  order            Int
  shortDescription String? @map("short_description")
  description      String  @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@map("pericias")
}

model CharacterPericia {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  periciaCode String    @map("pericia_code")
  points      Int       @default(0)

  @@unique([characterId, periciaCode])
  @@map("character_pericias")
}

// ══════════════════════════════════════════════════════════════════════
// APTIDÕES
// ══════════════════════════════════════════════════════════════════════

model Aptitude {
  id               String           @id @default(uuid()) @db.Uuid
  code             String           @unique
  name             String
  category         AptitudeCategory
  costPoints       Int              @default(2) @map("cost_points")
  description      String           @db.Text
  shortDescription String?          @map("short_description")

  prerequisites Json @default("{}")
  restrictions  Json @default("{}")

  isFree Boolean @default(false) @map("is_free")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  characterAptitudes CharacterAptitude[]

  @@map("aptitudes")
}

enum AptitudeCategory {
  COMBATE
  PODER
  PERICIA
  GERAL
  RESTRITA
}

model CharacterAptitude {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  aptitudeId  String    @map("aptitude_id") @db.Uuid
  aptitude    Aptitude  @relation(fields: [aptitudeId], references: [id])

  parameter        String?
  isFreeFromOrigin Boolean @default(false) @map("is_free_from_origin")

  @@unique([characterId, aptitudeId, parameter])
  @@map("character_aptitudes")
}

// ══════════════════════════════════════════════════════════════════════
// PODERES E EFEITOS
// ══════════════════════════════════════════════════════════════════════

model Power {
  id                     String        @id @default(uuid()) @db.Uuid
  code                   String        @unique
  name                   String
  /// Tradução em português (ex.: "Arte Ninja", "Elemento Fogo").
  translation            String?
  category               PowerCategory
  /// Elemento natural quando aplicável: "fogo", "agua", "vento", "raio",
  /// "terra", "gelo", "madeira" — `null` para poderes não-elementais.
  element                String?
  /// FK lógica para `KekkeiGenkai.code` (sem constraint Prisma) — preenchida
  /// quando o poder é um KG (ex.: hyouton, mokuton).
  associatedKekkeiGenkai String?       @map("associated_kekkei_genkai")
  /// FK lógica para `Clan.code` — preenchida quando o poder é restrito a um
  /// clã (ex.: kagejutsu → nara, juuken → hyuuga).
  associatedClan         String?       @map("associated_clan")
  description            String        @db.Text
  shortDescription       String?       @map("short_description")

  /// Stats numéricos/estruturais do poder — varia por tipo (rangeFormula,
  /// damageFormula, elementBonus, etc.). Shape livre por JSONB — ver
  /// `prisma/seed-data/powers.json` para exemplos.
  stats Json @default("{}")
  /// Regras de uso e compra (prerequisites, restrictedElements,
  /// freePowerLevelsByElement, etc.). Shape livre por JSONB.
  rules Json @default("{}")

  /// Mantido por compat — Lote 3 traz custo padrão = 1 ponto/nível.
  costPerLevel Int  @default(1) @map("cost_per_level")
  /// Mantido por compat com seeds antigos; campo `rules` é o novo padrão.
  restrictions Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")

  // PowerEffect virou entidade global (relação M:N via `effect.availableFor`),
  // então não há mais um array `effects` aqui — queries usam where in/array
  // contains. Ver `prisma/seed.ts` § seedPowerEffects.
  characterPowers CharacterPower[]

  @@map("powers")
}

/// Categorias de poder do Livro Básico 4.1b:
///   - COMUM        : qualquer um pode comprar
///   - RESTRITO     : pré-requisitos pesados, sem clã específico (ex.: Magen)
///   - RESTRITO_CLA : exige um clã específico (ex.: Juuken → Hyuuga)
///   - KEKKEI_GENKAI: ligado a uma Kekkei Genkai (ex.: Hyouton, Mokuton)
enum PowerCategory {
  COMUM
  RESTRITO
  RESTRITO_CLA
  KEKKEI_GENKAI
}

/// Efeitos de poder (Ninpou universal + variantes por elemento + hijutsus).
/// Cada efeito é uma entidade GLOBAL (não pertence a um poder único) — a
/// relação com poderes é modelada via `availableFor` (lista de `Power.code`).
/// Isto reflete a regra do livro: por exemplo, "Canhão" está disponível para
/// Ninpou + todos os elementos + KGs elementais, com restrições próprias por
/// poder modeladas dentro de `rules` ou implícitas no `availableFor`.
///
/// Seedado em ondas via `prisma/seed-data/effects-*.json`. Mantenha
/// compatibilidade com o shape definido no README do Lote 4a.
model PowerEffect {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique
  name             String
  /// Nível mínimo do poder para que o personagem possa comprar este efeito.
  minLevel         Int      @map("min_level")
  /// Códigos de `Power.code` que podem comprar este efeito (FK lógica, sem
  /// constraint Prisma — segue o padrão de `Clan.village` / `CharacterPericia`).
  availableFor     String[] @map("available_for")
  shortDescription String?  @map("short_description")
  description      String   @db.Text

  /// Stats numéricos/estruturais (action, range, target, damage, duration,
  /// rollType, chakraCost, etc.). Shape detalhado no README do Lote 4a.
  stats      Json
  /// Regras específicas do efeito (ex.: `halfChakraOption` no Canhão,
  /// `weaponTypes` em Criar Arma). Opcional.
  rules      Json?
  /// Lista de evoluções `[{ atLevel, name, description }]`. Não-skippable:
  /// pra usar a evolução N o personagem deve ter passado pelos níveis
  /// anteriores. Validação no motor (próxima fase).
  evolutions Json  @default("[]")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("power_effects")
}

model CharacterPower {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  powerId     String    @map("power_id") @db.Uuid
  power       Power     @relation(fields: [powerId], references: [id])
  level       Int

  @@unique([characterId, powerId])
  @@map("character_powers")
}

// ══════════════════════════════════════════════════════════════════════
// JUTSUS (instanciações de Power+Effect customizadas pelo personagem)
// ══════════════════════════════════════════════════════════════════════

model CharacterJutsu {
  id            String    @id @default(uuid()) @db.Uuid
  characterId   String    @map("character_id") @db.Uuid
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  powerId       String    @map("power_id") @db.Uuid
  powerEffectId String    @map("power_effect_id") @db.Uuid

  name        String
  kanjiName   String? @map("kanji_name")
  translation String?
  flavorText  String? @map("flavor_text") @db.Text
  imageUrl    String? @map("image_url")

  overrides Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("character_jutsus")
}

// ══════════════════════════════════════════════════════════════════════
// INVENTÁRIO
// ══════════════════════════════════════════════════════════════════════

model Equipment {
  id               String            @id @default(uuid()) @db.Uuid
  code             String            @unique
  name             String
  category         EquipmentCategory
  description      String            @db.Text
  shortDescription String?           @map("short_description")

  stats Json     @default("{}")
  tags  String[] @default([])

  basePrice Int @default(0) @map("base_price")

  createdAt DateTime @default(now()) @map("created_at")

  inventoryItems CharacterInventoryItem[]

  @@map("equipments")
}

enum EquipmentCategory {
  ARMA_CC
  ARMA_CD
  ARMA_ARREMESSO
  ARMADURA
  ESCUDO
  ITEM_NINJA
  CONSUMIVEL
  MISC
}

model CharacterInventoryItem {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  equipmentId String?    @map("equipment_id") @db.Uuid
  equipment   Equipment? @relation(fields: [equipmentId], references: [id])
  customName  String?    @map("custom_name")
  customStats Json?      @map("custom_stats")

  quantity Int     @default(1)
  notes    String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  @@map("character_inventory_items")
}

// ══════════════════════════════════════════════════════════════════════
// CATÁLOGOS DE REFERÊNCIA (CLÃS, VILAS, KEKKEI GENKAIS)
// ══════════════════════════════════════════════════════════════════════

model Clan {
  id               String  @id @default(uuid()) @db.Uuid
  code             String  @unique
  name             String
  /// FK lógica (string) para `Village.code`. `null` em clãs proscritos /
  /// extintos (ex.: Fuuma sem vila base, Kaguya extinto).
  village          String?
  description      String  @db.Text
  shortDescription String? @map("short_description")

  /// Estrutura livre. Campos esperados (ver `arcana-forge-spec/03-DATA-MODEL.md`
  /// §"Clan.benefits"):
  ///   - restrictedAptitudes: aptidões compráveis APENAS por este clã
  ///   - restrictedPowers: poderes compráveis APENAS por este clã
  ///   - hijutsuOptions: caminhos alternativos de criação (ex.: Hatake)
  ///   - kekkeiGenkai: código da KG associada (FK lógica)
  ///   - specialRules: texto livre
  benefits Json @default("{}")

  createdAt  DateTime    @default(now()) @map("created_at")
  characters Character[]

  @@map("clans")
}

model Village {
  id               String  @id @default(uuid()) @db.Uuid
  code             String  @unique
  name             String
  /// Nome completo em romaji (ex.: "Konohagakure no Sato").
  fullName         String? @map("full_name")
  /// Tradução em português (ex.: "Vila Oculta da Folha").
  translation      String?
  /// País onde a vila está localizada (ex.: "País do Fogo").
  country          String?
  /// Título do líder (ex.: "Hokage", "Kazekage").
  leaderTitle      String? @map("leader_title")
  description      String  @db.Text
  shortDescription String? @map("short_description")

  /// Estrutura livre — ver `arcana-forge-spec/03-DATA-MODEL.md`. Inclui pelo
  /// menos `freeAptitudes`; opcionalmente `iconography`, `tendencies`,
  /// `associatedClans`.
  benefits Json @default("{}")

  createdAt  DateTime    @default(now()) @map("created_at")
  characters Character[]

  @@map("villages")
}

model KekkeiGenkai {
  id               String  @id @default(uuid()) @db.Uuid
  code             String  @unique
  name             String
  /// Tradução em português (ex.: "Olho que Copia" para Sharingan).
  translation      String?
  /// FK lógica para `Clan.code` — clã canonicamente vinculado à KG (ex.:
  /// Hyouton → Yuki, Sharingan → Uchiha). `null` quando a KG não tem clã
  /// único (raro).
  associatedClan   String? @map("associated_clan")
  description      String  @db.Text
  shortDescription String? @map("short_description")

  /// Shape livre — ver `arcana-forge-spec/03-DATA-MODEL.md` §"KekkeiGenkai.benefits":
  ///   - mainPowerCode, freePowerLevelsByElement, linkedAptitudes,
  ///     linkedPowers, restrictedElements, additionalHardness, etc.
  benefits Json @default("{}")

  createdAt  DateTime    @default(now()) @map("created_at")
  characters Character[]

  @@map("kekkei_genkais")
}

// ══════════════════════════════════════════════════════════════════════
// IMAGENS DO PERSONAGEM (galeria)
// ══════════════════════════════════════════════════════════════════════

model CharacterImage {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  url           String
  storagePath   String  @map("storage_path")
  fileName      String? @map("file_name")
  width         Int?
  height        Int?
  fileSizeBytes Int?    @map("file_size_bytes")

  label String?

  uploadedAt DateTime @default(now()) @map("uploaded_at")

  @@index([characterId])
  @@map("character_images")
}

// ══════════════════════════════════════════════════════════════════════
// DIÁRIO
// ══════════════════════════════════════════════════════════════════════

model DiaryEntry {
  id          String    @id @default(uuid()) @db.Uuid
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)

  title     String
  body      String    @db.Text
  entryDate DateTime? @map("entry_date")
  tag       String?

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([characterId])
  @@index([deletedAt])
  @@map("diary_entries")
}

// ══════════════════════════════════════════════════════════════════════
// COMPARTILHAMENTO
// ══════════════════════════════════════════════════════════════════════

model ShareLink {
  id          String    @id @default(uuid()) @db.Uuid
  token       String    @unique
  characterId String    @map("character_id") @db.Uuid
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  isActive     Boolean   @default(true) @map("is_active")
  viewCount    Int       @default(0) @map("view_count")
  lastViewedAt DateTime? @map("last_viewed_at")

  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at")

  @@index([token])
  @@index([characterId])
  @@map("share_links")
}
